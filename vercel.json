{
    "rewrites": [
        {
            "source": "/static",
            "destination": "/static"
        },
        {
            "source": "/(.*)",
            "destination": "api/index.py"
        }
    ],
    "functions": {
        "api/index.py": {
            "runtime": "git+https://github.com/jperelli/vercel-python-gis.git#main@1.0.0"
        }
    },
    "buildCommand": "dnf install -y gdal310-devel geos-devel proj-devel && python manage.py collectstatic --noinput"
}